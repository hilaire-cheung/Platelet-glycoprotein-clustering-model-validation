<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[globals [element-scheme color-scheme color-scheme2 effective-receptors-link cluster-count
  dimer-count trimer-count tetramer-count pentamer-count hexamer-count septamer-count octamer-count enneamer-count decamer-count hendecamer-count dodecamer-count triskaidecamer-count tetrakaidecamer-count pentakaidecamer-count hexakaidecamer-count heptakaidecamer-count octakaidecamer-count enneakaidecamer-count icosamer-count plus-count
  count-group-list counter-list count-group-list-v2 counter-list-v2 count-group-list-v3 counter-list-v3 count-group-list-v4 counter-list-v4
  molecule-with-syks-list counter-molecule-with-syk-list
  molecule-with-receptors-list counter-molecule-with-receptor-list counter-receptor-list
  size-of-cluster  total-size mean-size r-absolute s-absolute l-absolute ll-absolute max-absolute
  time-step-counter  element-state-counts-list   coeff-of-variance-list   mean-zero-list   steady-state-checker
  tot-r-dict

  cluster-coefficient-
]
extensions [ nw table]
breed [ ligands ligand]
; breed [ dimers dimer]
breed [ receptors receptor]
breed [ syks syk ]

; every turtle possesses the following attributes:
; element-state: the state of element such as R0, R1, R2, R3, R4 and R5. Please refer to documentation for definitions of the states.
; product-id: the identifier of each unique molecule or product formed, it is similar in function to that of a leading turtle in prior versions for clustering. The default value is self.
; product-turn and speed: this would be same as that of the product id.
; molecule: The molecule based on the elements it comprises of.
;--------------------------------------------
; ligand specific attributes:
; receptor-bound: if bounded to a receptor (self explanatory).
; ligand-state and reversible? (for the monomers, dimers and tetramer in setup, as they are irreversible, examples can be that of fab2 or antibodies, nanobodies etc).
; l1 and l2: two ligands which are dimers. By default, they are nobody.
; --------------------------------------------
; receptor specific attributes:
; phosphorylated? boolean, turns true if the receptor is phoshorylated.
; ligand-bound: self of the ligand that is connected. If no ligands are connected it would be nobody.
; protein-bound: self of syk that is connected. If no syks are connected it would be nobody.
; receptor-bound: a list of other receptors connected to a particular receptor. This will be an empty list if there are no connections.

turtles-own [element-state product-id product-turn product-speed molecule cluster-id]
ligands-own [receptor-bound ligand-bound dimer-bound ligand-state reversible?  l1 l2 lig-type ]
;dimers-own [family product-id product-turn site1-bounded?  site2-bounded?]
receptors-own [phosphorylated? ligand-bound protein-bound receptor-bound receptor-type can-phosphorylated?]
syks-own [kinectically-active? inter-complex? site1-bound  site2-bound ]

to setup
  clear-all
  setup-globals
  setup-species
  setup-dense-region
  ; set-count-group-list
  reset-ticks
end

; setting up color for each element state
to setup-globals
  ; each element's colors are mapped in the same order for both lists: element-scheme and color-scheme
  ; set element-scheme ["L0" "L1" "L0L0" "L1L0" "L1L1" "R0" "R1" "R2" "R3" "R4" "R5" "S0" "S1" "S2" "S3" "S4" "S5" "RX0" "RX1" "RX2" "RX3" "RX4" "RX5" ] ; existing now without distingushing major and minor
  set element-scheme ["L0" "L1" "L^0L_0" "L^1L_0" "L^0L_1" "L^1L_1" "R0" "R1" "R2" "R3" "R4" "R5" "S0" "S1" "S2" "S3" "S4" "S5" "RX0" "RX1" "RX2" "RX3" "RX4" "RX5" ] 
  ;set color-scheme [ 29 45 29 29 45 135 lime 135 lime lime lime black black red red white white ]
  ; set color-scheme [ 96 45 96 96 45 135 lime 135 lime lime lime black blue red red white white black violet black violet violet violet] ; existing now without distingushing major and minor
  set color-scheme [ 96 45 96 96 96 45 135 lime 135 lime lime lime black blue red red white white black violet black violet violet violet]
  ;set color-scheme [ 28 45 28 28 45 blue lime blue lime lime lime black black red red white white ]
  ;set color-scheme [ 137 45 137 137 45 blue lime blue lime lime lime black black red red white white ]
  set effective-receptors-link limit-rr-links
  if limit-rr-links = "unlimited"
  [ set effective-receptors-link R ]
  set-patch-size my-patch-size
  resize-world world-dimension2 world-dimension world-dimension2 world-dimension
  ; for steady state
  set element-state-counts-list []
  set coeff-of-variance-list []
  set mean-zero-list []
  set steady-state-checker []
  set time-step-counter 0
  ; creating a list of lists for count of families
  foreach element-scheme
  [
    set element-state-counts-list  lput [] element-state-counts-list
    set coeff-of-variance-list lput [] coeff-of-variance-list
    set mean-zero-list lput [] mean-zero-list
    set steady-state-checker lput false steady-state-checker
  ]
  set max-absolute (count patches / (r-size ^ 2))
  set tot-r-dict table:make

  set counter-molecule-with-receptor-list []
  set counter-receptor-list []
end

; setting up the 4 base species
to setup-species
  setup-monomers
  setup-receptors 1
  setup-receptors 2
  setup-syks
  setup-dimers
end

; setting values for monomeric ligand
to setup-monomers
  ; set l-absolute ((L / 100) * (count patches / (r-size ^ 2)))
  create-ligands L; ( (L / 100) * (count patches / (r-size ^ 2)))
  [
    set shape "monomer"
    set size r-size
    __set-line-thickness -4
    set product-turn random-float 360
    set receptor-bound nobody          ; by default it would be nobody. If it got connected with any of the receptors around, it will become self of that receptor.
    set ligand-state "monomer"                ; false for monomeric ligand.
    set ligand-bound []                ; empty list by default. If it is connected to any ligand, the self of that ligand will be stored.
    set dimer-bound []                 ; if ligand got connected to any dimer, the self of ligand in dimer with l1 = self will be stored. (not implemented now as there are no such reactions as of now)
    set element-state get-ligand-element-state
    set molecule element-state
    set color get-color
    set product-id self
    set lig-type "major"                ; type of ligand could be major, minor. We are keeping for monomer default as major, for dimer the other one as minor
    set l1 nobody                      ; l1 and l2 are nobody for monomeric ligand. For dimer ligand, l1 and l2 help to identify the connected ligands.
    set l2 nobody
    set cluster-id nobody
    setxy random-xcor random-ycor
   ]
end

; to get the element state of monomeric ligand
to-report get-ligand-element-state
  if receptor-bound != nobody [report "L1" ] ; L1 if the ligand is receptor bound
  report "L0"
end

; to get the color based on the element state mentioned in the element-scheme and color-scheme
to-report get-color
  let pos position element-state element-scheme
  report item pos color-scheme
end


; to set up receptors
to setup-receptors [rtype]
  ;set r-absolute ((R / 100) * (count patches / (r-size ^ 2)))
  set r-absolute R
  ;create-receptors ( (R / 100) * (count patches / (r-size ^ 2)))
  if rtype = 2
  [ set r-absolute RX ]
  create-receptors r-absolute
  [
    set shape "receptor-with-border"
    set size r-size
    set phosphorylated? false
    ; setting the receptor type
    ; 1 is ordinary one
    ; 2 special one
    set receptor-type rtype
    set can-phosphorylated? true
    if receptor-type = 2
    [ set can-phosphorylated? allow-phosphorylation? ]
    if random-float 100 < initial-R1-presence and receptor-type = 1 and can-phosphorylated?
    [
      set phosphorylated? true
    ]
    set ligand-bound nobody
    set protein-bound nobody
    set receptor-bound []
    set element-state get-receptor-element-state
    set molecule element-state
    set color get-color
    set product-id self
    __set-line-thickness -4
    set cluster-id nobody
    setxy random-xcor random-ycor
  ]
end

; to get the element state of receptor based on the values
to-report get-receptor-element-state
  if receptor-type = 2
  [
    if phosphorylated? and ligand-bound != nobody and protein-bound != nobody
    [ report "RX5" ]
    if phosphorylated? and protein-bound != nobody
    [ report "RX4" ]
    if phosphorylated? and ligand-bound != nobody
    [ report "RX3" ]
    if ligand-bound != nobody
    [ report "RX2" ]
    if phosphorylated?
    [ report "RX1" ]
    report "RX0"
  ]
  if phosphorylated? and ligand-bound != nobody and protein-bound != nobody
  [ report "R5" ]
  if phosphorylated? and protein-bound != nobody
  [ report "R4" ]
  if phosphorylated? and ligand-bound != nobody
  [ report "R3" ]
  if ligand-bound != nobody
  [ report "R2" ]
  if phosphorylated?
  [ report "R1" ]
  report "R0"
end

; to setup syks
to setup-syks
  ;set S-absolute ((S / 100) * (count patches / (r-size ^ 2)))
  set S-absolute S
  ;create-syks ( (S / 100) * (count patches / (r-size ^ 2)))
  create-syks S
  [
    set shape "syk"
    set size r-size * 1.6
    set kinectically-active? false
    set inter-complex? false
    set site1-bound nobody
    set site2-bound nobody
    set element-state get-syk-element-state
    set molecule element-state
    set color get-color
    set product-id self
    set cluster-id nobody
    setxy random-xcor random-ycor
  ]
end

; to get the element state of syks
to-report get-syk-element-state
  if kinectically-active? and inter-complex? and site1-bound != nobody  and site2-bound != nobody
  [ report "S5" ]
  if inter-complex? and site1-bound != nobody  and site2-bound != nobody
  [ report "S4" ]
  if kinectically-active? and site1-bound != nobody  and site2-bound != nobody
  [ report "S3" ]
  if site1-bound != nobody  and site2-bound != nobody
  [ report "S2" ]
  if site1-bound != nobody  or site2-bound != nobody
  [ report "S1" ]
  report "S0"
end

; to set up dimers using two monomeric ligands
to setup-dimers
  ; create twice the number of monomers to create dimers
  ;set ll-absolute ((LL / 100) * (count patches / (r-size ^ 2)))
  ;create-ligands round(2 * LL / 100 * max-absolute)
  create-ligands round(2  * LL)
  [
    set shape "monomer"
    set size r-size * 0.75
    set receptor-bound nobody
    set ligand-state "dimer"
    set reversible? false
    set product-id self
    set cluster-id nobody
    set lig-type nobody
    set ligand-bound []
  ]
  let dimeric-ligands [self] of ligands with [ ligand-state = "dimer"]
  ; setup the two monomers as major and minor
  ; the self of major will be the product-id for both the monomers forming a dimeric ligand
  let i 0
  ;while [ i < round (2 * LL / 100 * max-absolute ) ]
  while [ i < (2 * LL) ]
  [
    let major item i dimeric-ligands
    let minor item (i + 1) dimeric-ligands
    ask major [ set lig-type "major" set l1 self set l2 [self] of minor  set ligand-bound lput ([self] of minor) ligand-bound create-link-with minor [ set hidden? true] ]
    ask minor [ set lig-type "minor" set product-id [product-id] of major set l1 [self] of major set l2 self set ligand-bound lput ([self] of major) ligand-bound]
    set i (i + 2)
  ]
  ; setting the dimer and aligning the monomers together
  ask ligands with [product-id = self]
  [ setxy random-xcor random-ycor ]
  ask ligands with [product-id  != self]
  [
    setup-minor-ligand
  ]
  ; set the element state as dimer
  ask ligands with [ligand-state = "dimer" ]
  [
    set element-state get-dimer-element-state
    set molecule element-state
    set color get-color
  ]
end

; positioning the minor monomer adjacent to the major one
to setup-minor-ligand
  set heading [heading] of product-id
  set xcor ([xcor] of product-id ) - (1.22 * cos heading)
  set ycor ([ycor] of product-id ) - (1.22 * sin (180 + heading))
end

; to get the element state
to-report get-dimer-element-state
  let l1-bound [receptor-bound] of l1
  let l2-bound [receptor-bound] of l2
  if l1-bound != nobody and l2-bound != nobody
  [ report "L^1L_1" ]
  if l1-bound != nobody and l2-bound = nobody
  [ report "L^1L_0" ]
  if l1-bound = nobody and l2-bound != nobody
  [ report "L^0L_1" ]
  report "L^0L_0"
end

; routine to get the name of the molecule of a given product (given product-id) and join element states of every element within the molecule to output a final name via concatenation.
; only one element state will be used for dimer as both have the same states.
to-report get-molecule-name [xproduct]
  let l-elements [element-state] of ligands with [product-id = xproduct and ligand-state = "monomer"]
  let r-elements [element-state] of receptors with [product-id = xproduct ]
  let s-elements [element-state] of syks with [product-id = xproduct ]
  let d-elements [element-state] of ligands with [product-id = xproduct and ligand-state = "dimer" and l1 = self]
  let t-elements [element-state] of ligands with [product-id = xproduct and ligand-state = "tetramer" and l1 = self]
  
  let molecule-name ""
  foreach l-elements
  [ element ->
    set molecule-name (word molecule-name element)
  ]
  foreach r-elements
  [ element ->
    set molecule-name (word molecule-name element)
  ]
  foreach s-elements
  [ element ->
    set molecule-name (word molecule-name element)
  ]
  foreach d-elements
  [ element ->
    set molecule-name (word molecule-name element)
  ]
  foreach t-elements
  [ element ->
    set molecule-name (word molecule-name element)
  ]
  report molecule-name
end

; to slow down the region which is marked as yellow i.e. lipid rafts.
; to have fifty patches together and each set of fifty patches will be
; randomly located.
to  setup-dense-region
  ask patches [ set pcolor 8 ]
  if dense-region?
  [

    let cnt-patches (dense-area / 100) * count patches  ; number of patches to be colored
    let yellow-space-num cnt-patches / dense-size              ; number of different regions to be formed which are of size 50
    ask n-of yellow-space-num  patches [ set pcolor yellow]  ; starting point of creating yellow regions
    let yellow-patches count patches with [ pcolor = yellow ]
    if yellow-space-num >= 1
    [
      while [yellow-patches <= cnt-patches]               ; creating regions around starting points and have total size less than or equal to required percentage of rafts
      [
        ask patches with [ pcolor = yellow ] [
          ask neighbors with [ pcolor = black ]
          [ set pcolor [ pcolor ] of myself ]
        ]
        set yellow-patches count patches with [ pcolor = yellow ]
      ]
    ]

    ; ask n-of cnt-patches patches [ set pcolor yellow]
  ]
end


; go functions
; these functions implement dissociation, association and transformation

to go
  if ((ticks = stopwatch) or is-steady-state?)
  [ stop ]
  ; print "GO AGAIN!!!!"
  move
  asssociate-and-transform

  dissociate-and-reverse


  set-cluster-id
  write-cluster-characteristics
  count-molecule-with-receptors
  count-molecule-with-receptors-for-hist
  ;histogram counter-molecule-with-receptor-list

;  ask links
;  [
;    if is-receptor? end1 and is-receptor? end2
;    [
;      show (word "END1:" [receptor-bound] of end1)
;      show (word "END2:" [receptor-bound] of end2)
;    ]
;  ]

  ;set-cluster-number
  ;show set-r-s-readouts
  ;set-r-s-readouts
  ;get-count-of-groups
  ;get-count-of-groups-v2
  ;get-count-with-double-bound-s
  ;write-into-file
  tick
end

; to allow the products to move.
to move
  ; to set the speed and turning angle for the leading element in the product/ molecule
  ask turtles with [ product-id = self ]
  [
    let size-of-product  (count turtles with [product-id = [product-id] of myself])
    set product-speed (1 / size-of-product)           ; reducing the speed based on the size of the product formed
    if pcolor = yellow
    [
      set product-speed product-speed * coefficient-of-diffusion ; in case of rafts initialised, reduce the speed in rafts
    ]

    set product-turn random-float 10 - random-float 10
      ; arrange other elements with respect to the location of leading element
    let adjustment 0 ;adjustment is to adjust the position of the elements. if it is zero all the elements will overlap with each other
    ask turtles with [ product-id = [product-id] of myself and product-id != self ] [
      go-on-receptor-in-molecule product-id adjustment          ; aligning receptors close to leading product id
      go-on-ligand-in-molecule product-id adjustment            ; aligning ligands close to leading product id
      go-on-syk-in-molecule product-id adjustment               ; aligning syks close to leading product id
      set product-turn [product-turn] of product-id
      set product-speed [product-speed] of product-id
      set adjustment (adjustment + 0.05)
    ]
  ]

  ; moving the elements
  ask turtles [
    rt  product-turn
    fd product-speed
  ]

end

; association or transformation of the elements based on all themes
to asssociate-and-transform
  ;show "START"
  phosphorylation-process
  if theme-2 or theme-12 or theme-13 [
    ;show "before here 2"
    dimerization-of-r
    ;show "after here 2"
  ]
  syk-activation
  if theme-4  or theme-14 [ ;show "before here 3"
    attaching-syk-within
    ;show "after here 3"
  ]
  if theme-6 [dimerize-ligands]
  if theme-8  [ligand-and-receptor 1]
  if theme-18 [ligand-and-receptor 2]
  if theme-9  [; show "before here 4"
    syk-and-phosphorylated-r 1
    ;show "after here 4"
  ]

  if  theme-19 [ syk-and-phosphorylated-r 2 ]

  ;show "THE END"

end

; routine to enable phosphorylation process
; by default the receptors are non phosphorylated
; the receptors transform into phosphorylated receptors under various themes
; R0 will change only under theme 1 and 10 while others could transform under themes 1,5 and 10
to  phosphorylation-process

  let already-set? false
  ask receptors with [not phosphorylated? and can-phosphorylated?]
  [
    ;show "before here 1"
    let themes (list "theme-1" "theme-5" "theme-10") ; list the themes that apply for phosphorylation
    if element-state = "R0"
    [ set themes (list "theme-1"  "theme-10") ]
    if receptor-type = 2
    [
      set themes (list "theme-11" "theme-15" "theme-20")
      if element-state = "RX0"
      [ set themes (list "theme-11"  "theme-20") ]
    ]
    ; to get the themes if the switch is on and apply rates corresponding to the applicable themes
    ; to get a boolean in case the transformation is possible ( if the randomly generated number is less than
    ; corresponding rate of reaction)
    ; if theme 1 and 5 are on and rate is applicable for 5 then output will be
    ; [["theme-1" "theme-5"] [false true]]

    let theme-rates get-theme-rates themes
    let theme-list  item 0 theme-rates             ; to get the list of themes applicable
    let rate-list  item 1 theme-rates              ; to get if the process is applicable under the applicable the theme
    let transform-list? will-transform? rate-list
    ; if theme-1 is enabled and it could be transformed (true in rate-list)
    ; then we can phosphorylate the receptor, similar logic from themes 5 and 10.
    ifelse receptor-type = 1
    [
      if member? "theme-1" theme-list and theme-1
      [
        let pos position "theme-1" theme-list
        if (item pos transform-list? and member? element-state molecule)
        [
          phosphorylate true
          set  already-set? true
        ]
      ]
      if member? "theme-5" theme-list and not already-set? and theme-5
      [
        let pos position "theme-5" theme-list
        if (item pos transform-list? and ligand-bound != nobody )
        [
          phosphorylate true
          set  already-set? true
        ]
      ]
      if member? "theme-10" theme-list and  is-there-any-syk? and not already-set? and theme-10
      [
        let pos position "theme-10" theme-list
        if (item pos transform-list? and protein-bound != nobody )
        [
          phosphorylate true
          set  already-set? true
        ]
      ]
    ]
    [
      if member? "theme-11" theme-list and theme-11
      [
        let pos position "theme-11" theme-list
        if (item pos transform-list?)
        [
          phosphorylate true
          set  already-set? true
        ]
      ]
      if member? "theme-15" theme-list and not already-set? and theme-15
      [
        let pos position "theme-15" theme-list
        if (item pos transform-list? and ligand-bound != nobody )
        [
          phosphorylate true
          set  already-set? true
        ]
      ]

      if member? "theme-20" theme-list and  is-there-any-syk? and not already-set? and theme-20
      [
        let pos position "theme-20" theme-list
        if (item pos transform-list? and protein-bound != nobody )
        [
          phosphorylate true
          set  already-set? true
        ]
      ]
    ]
    ;show "after here 1"
  ]

end

; routine for phosphorylation
; setting the variable true for phosphorylation and false for unphosphorylation
to phosphorylate [ xstate ]
  set phosphorylated? xstate                       ; phosphorylate or unphosphorylate the receptor state
  set element-state get-receptor-element-state
  set color get-color
  update-molecule
end

; updating the molecule name for all the elements in a product
to update-molecule
  ; get the molecule name
  set molecule get-molecule-name product-id
  ; set the molecule name for all the elements in the molecule
  ; the molecule is identified using the product id
  ask turtles with [product-id = [product-id] of myself]
  [ set molecule [molecule] of myself ]
end

; From the given list of themes, identify the rates and return the values in the interface
; For example if the list comprises of [ "theme-1"], the rate rate-for-theme-1 will be returned
; if it is [ "theme-1" , "theme-2"] the list [ rate-for-theme-1  rate-for-theme-2 ] will be returned
to-report get-theme-rates [ themes ]
  let theme-list []
  let rate-list []
  foreach themes
  [ theme ->
    if (runresult theme)
    [
      set theme-list lput theme theme-list
      let temp (word "rate-for-" theme)
      set rate-list lput (runresult temp) rate-list
    ]
  ]
  report (list theme-list rate-list)
end

; Check if the element should transform or not.
; if random-float 100 < kn, it would transform.
; this routine tries to handle different number of themes if multiple themse are
; applicable
to-report will-transform? [theme-list]
  let len-list length theme-list
  let rand-value random-float (100 * len-list)
  let transform-list []
  ; if only one theme is considered
  if len-list = 1
  [
    ifelse rand-value < item 0 theme-list
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]
  ]
   ; if two themes are considered
  if len-list = 2
  [
    ifelse (rand-value < item 0 theme-list )
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]

    ifelse ((rand-value >= item 0 theme-list) and
      (rand-value < (item 0 theme-list + item 1 theme-list) ))
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]
  ]
   ; if three themes are considered
  if len-list = 3
  [
    ifelse (rand-value < item 0 theme-list )
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]
    ifelse (rand-value >= item 0 theme-list) and
      (rand-value < (item 0 theme-list + item 1 theme-list))
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]
    ifelse ((rand-value >= (item 0 theme-list + item 1 theme-list)) and
      (rand-value < (item 0 theme-list + item 1 theme-list + item 2 theme-list)))
    [set transform-list lput true transform-list ]
    [set transform-list lput false transform-list ]
  ]
  report transform-list
end


to-report is-there-any-syk?
  if any? syks-here with [element-state = "S3" ]
  [ report true ]
  report false
end

; routine to dimerise receptors by finding nearby receptors and dimerise as per the rate for theme 2.
; to capture the list of all receptors connected to the receptor, in the form of a list
; update the product id and molecule post-dimerisation
to dimerization-of-r
  if any? receptors with [ length receptor-bound < effective-receptors-link ]
  [
    ask receptors with [  length receptor-bound < effective-receptors-link ]
    ;ask receptors with [ length receptor-bound = 0 ]
    [
      ; get list of receptors that are already connected to the asking receptor
      let connected-receptors receptor-bound

      ; identify any receptors which are not already connected
      let near-by-molecules other receptors-here with [ not member? self connected-receptors and  length receptor-bound + length connected-receptors < effective-receptors-link ]
      ; if there are any other receptors which are not connected to the receptor, connect and dimerise
      if any? near-by-molecules
      [
        let near-by-molecule one-of near-by-molecules
        let rtype [receptor-type] of near-by-molecule
        let rand-value random-float 100
        ; themes based on the receptor types
        if ( rand-value < rate-for-theme-2 and theme-2 and receptor-type = 1 and rtype = 1) or (rand-value < rate-for-theme-12 and theme-12  and receptor-type = 2 and rtype = 2) or (rand-value < rate-for-theme-13 and theme-13  and ((receptor-type = 2 and rtype = 1) or (rtype = 2 and receptor-type = 1)))
        [
          ; add the receptor bound to self of others
          let receptor-list (sentence receptor-bound ([receptor-bound] of near-by-molecule) ([self] of near-by-molecule)  self )
          ask turtles with [product-id = [product-id] of myself ]
          [
            set product-id [product-id] of near-by-molecule
          ]

          ask receptors with [product-id = [product-id] of myself and member? self receptor-list ]
          [
            let new-receptor-list receptor-list
            if member? self receptor-list
            [
              set new-receptor-list remove self new-receptor-list
            ]
            set receptor-bound new-receptor-list
            ;set color yellow
            __set-line-thickness .2

          ]

          ask near-by-molecule
          [

            create-links-with other receptors with [product-id = [product-id] of myself and (not in-link-neighbor? [self] of myself) and member? self [receptor-bound] of myself]
            [set hidden? true ]

          ]

          set color get-color
          ;set color yellow
          ; set molecule get-molecule-name product-id
          update-molecule
          go-receptor-in-molecule product-id ;
        ]
      ]
    ]
  ]
end

to-report effective-link-count[ rtype ]
  let cnt-receptor 0
  foreach receptor-bound
  [ recep ->
    if [receptor-type] of recep = rtype
    [
      set cnt-receptor (cnt-receptor + 1)
    ]
  ]
  report cnt-receptor
end
; positioning receptor post-dimerisation with respect to the other receptor(s)
to go-receptor-in-molecule [xreceptor]
  set heading [heading] of xreceptor
  set xcor ([xcor] of xreceptor ) + (1.6 * cos heading)
  set ycor ([ycor] of xreceptor ) + (1.6 * sin (180 + heading))
end

; to activate syk from S2 to S3
; theme 3 applies here
to  syk-activation

  ask syks with [not kinectically-active? and site1-bound != nobody and site2-bound != nobody]
  [
    let themes (list "theme-3" )
    let theme-rates get-theme-rates themes
    let theme-list  item 0 theme-rates
    let rate-list  item 1 theme-rates
    let transform-list? will-transform? rate-list
    if member? "theme-3" theme-list
    [
      let pos position "theme-3" theme-list
      if (item pos transform-list?)
      [
        syk-activate
      ]
    ]
  ]
end


; updating the states to activate syk
to syk-activate
  set kinectically-active? true
  set element-state get-syk-element-state
  set color get-color
  update-molecule
end

; attaching syk within a molecule
; theme 4 applies here
to attaching-syk-within
  ask syks with [ element-state = "S1" ]
  [
    let themes ["theme-4"]
    if theme-4 and not theme-14
    [ set themes ["theme-4"] ]
    if theme-14 and not theme-4
    [ set themes ["theme-14"] ]
    if theme-14 and theme-4
    [ set themes ["theme-4" "theme-14"] ]
    let theme-rates get-theme-rates themes
    let theme-list  item 0 theme-rates
    let rate-list  item 1 theme-rates
    let already-set? false
    let transform-list? will-transform? rate-list
    if member? "theme-4" theme-list
    [
      let pos position "theme-4" theme-list
      if (item pos transform-list?)
      [
        attach-syk 1
        set  already-set? true
      ]
    ]
    if member? "theme-14" theme-list
    [
      let pos position "theme-14" theme-list
      if (item pos transform-list?)
      [
        attach-syk 2
        set  already-set? true
      ]
    ]
    ;    if member? "theme-9" theme-list and not already-set?
;    [
;
;      let pos position "theme-9" theme-list
;      if (item pos transform-list?)
;      [
;        attach-syk
;        set  already-set? true
;      ]
;    ]

  ]
end

; to attach syk if state of syk is S1. If there are any receptors here,
; then site2 will become bound with the nearest receptor,
; to also update the molecule name accordingly.
to attach-syk [ rtype ]
  let the-molecules receptors-here with [phosphorylated? and protein-bound = nobody and receptor-type = rtype ]
  if any? the-molecules
  [

    let the-molecule one-of the-molecules
    ifelse site1-bound = nobody
    [ set site1-bound [self] of the-molecule ]
    [ if site2-bound = nobody [set site2-bound [self] of the-molecule ] ]

    set element-state get-syk-element-state
    set color get-color
    ; create-link-with the-molecule [ set hidden? true]
    ask turtles with [product-id = [product-id] of myself ]
    [
      set product-id [product-id] of the-molecule
    ]
    create-link-with the-molecule [ set hidden? true ]
    ask the-molecule
    [
      set protein-bound [self] of myself
      set element-state get-receptor-element-state
      set color get-color
     ]
    update-molecule
  ]
end

; routine to dimerise ligands
; if the ligands are not dimers, they may dimerise with fellow ligands that are not dimers
; if the ligands are dimers they may dimerize with dimers only which are initialised in the setup function
to dimerize-ligands 
  ask ligands with [ligand-state = "monomer" ]
  [
    let connected-ligands get-connected-ligands
    let near-by-molecules other ligands-here with [ligand-state = "monomer" and not member? self connected-ligands]
    if any? near-by-molecules and random-float 100 < rate-for-theme-6
    [
      let near-by-molecule one-of near-by-molecules
      let major self
      set color get-color
      set reversible? true
      set lig-type "major" 
      set ligand-state "dimer" 
      set l1 self 
      set l2 [self] of near-by-molecule
      set ligand-bound lput ([self] of near-by-molecule) ligand-bound 
      create-link-with near-by-molecule [ set hidden? true]
      setxy random-xcor random-ycor
      ask near-by-molecule [ 
        set lig-type "minor" 
        set ligand-state "dimer"
        set product-id [product-id] of major 
        set l1 [self] of major 
        set l2 self 
        set ligand-bound lput ([self] of major) ligand-bound
        set heading [heading] of product-id
        set xcor ([xcor] of product-id ) - (1.22 * cos heading)
        set ycor ([ycor] of product-id ) - (1.22 * sin (180 + heading))
      ] 
      ask ligands with [ligand-state = "dimer" ]
      [
        set element-state get-dimer-element-state
        set molecule element-state
        set color get-color
        
      ]
    ]
  ]
  ask ligands with [ligand-state = "dimer" and lig-type = "major" ]
  [
    show sentence self ligand-state
    let connected-ligands get-connected-ligands
    let near-by-molecules other ligands-here with [ligand-state = "dimer" and lig-type = "major" and not member? self connected-ligands]
    if any? near-by-molecules and random-float 100 < rate-for-theme-6
    [
      let near-by-molecule one-of near-by-molecules
      let major self
      set color get-color
      set reversible? false
      set ligand-state "tetramer"
      ask l2 [
        set ligand-state "tetramer"
        set ligand-bound lput ([l1] of near-by-molecule) ligand-bound 
        set ligand-bound lput ([l2] of near-by-molecule) ligand-bound
        ask turtles with [product-id = [product-id] of myself]
        [ set product-id [product-id] of major ] 
      ]
      set ligand-bound lput ([l1] of near-by-molecule) ligand-bound 
      set ligand-bound lput ([l2] of near-by-molecule) ligand-bound 
      create-link-with near-by-molecule [ set hidden? true]
      setxy random-xcor random-ycor
      ask near-by-molecule [ 
        set ligand-state "tetramer"
        ask l2 [
          set ligand-state "tetramer" 
          set ligand-bound lput ([l1] of major) ligand-bound
          set ligand-bound lput ([l2] of major) ligand-bound
          ask turtles with [product-id = [product-id] of myself]
          [ set product-id [product-id] of major ] 
        ]
        set product-id [product-id] of major 
        set l1 [self] of major 
        set l2 self 
        set ligand-bound lput ([l1] of major) ligand-bound
        set ligand-bound lput ([l2] of major) ligand-bound
        set heading [heading] of product-id
        set xcor ([xcor] of product-id ) - (1.22 * cos heading)
        set ycor ([ycor] of product-id ) - (1.22 * sin (180 + heading))
      ]  
      set l1 self
      set l2 [self] of near-by-molecule
      ask ligands with [ligand-state = "tetramer" ]
      [
        set element-state get-tetramer-element-state
        set molecule element-state
        set color red
      ]
    ]
  ]
end

to-report get-connected-ligands 
  if ligand-state = "monomer"
  [ report ligand-bound ]
  if ligand-state = "dimer"
  [
    report sentence [ligand-bound] of l1  [ligand-bound] of l2
  ]
  report []
end

to-report get-tetramer-element-state
  let ligand-list sentence self ligand-bound
  let ele-state ""
  foreach ligand-list [
    lig-temp -> 
    let rep "L_"
    let status 1
    if [lig-type] of lig-temp = "major"
    [set rep "L^"]
    if [receptor-bound] of lig-temp  = nobody
    [set status 0]
    let temp-state word rep status
    set ele-state word ele-state temp-state
  ]
  report ele-state
end
; the ligand and receptors react to form a ligand receptor complex
; the receptor bound attrubute becomes true and for receptors, ligand-bound attribute becomes true in this routine,
; the state and moleule will be updated accordingly.
to ligand-and-receptor [ rtype ]
  ask ligands  with [ receptor-bound = nobody]
  [
    let rand-value (random-float 100)
    if any? receptors-here with [ligand-bound = nobody and ((rtype = 1 and receptor-type = rtype and rand-value < rate-for-theme-8) or (rtype = 2 and receptor-type = rtype and rand-value < rate-for-theme-18)) ]
    [
      let near-by-receptor one-of receptors-here with [ligand-bound = nobody and ((rtype = 1 and receptor-type = rtype and rand-value < rate-for-theme-8) or (rtype = 2 and receptor-type = rtype and rand-value < rate-for-theme-18)) ]
      set receptor-bound near-by-receptor
      create-link-with near-by-receptor [ set hidden? true ]
      ifelse ligand-state = "tetramer"
      [
        let xproduct product-id
        ask ligands with [product-id = xproduct]
        [ 
          set element-state get-tetramer-element-state 
          set color green
        ]
      ]
      [
        ifelse ligand-state = "dimer"
        [
          ifelse l1 = self
          [ set element-state get-dimer-element-state
            set color get-color
            ask l2 [ set element-state get-dimer-element-state set color get-color]
          ]
          [
            set element-state get-dimer-element-state
            set color get-color
            ask l1 [ set element-state get-dimer-element-state set color get-color ]
          ]
        ]
        [ set element-state get-ligand-element-state ]
      ]
      ; set color get-color
      ask turtles with [product-id = [product-id] of myself ]
      [
        set product-id [product-id] of near-by-receptor
      ]
      ;create-link-with near-by-receptor [ set hidden? true]
;      set heading [heading] of product-id
;      set xcor ([xcor] of product-id ) + (1.22 * cos heading)
;      set ycor ([ycor] of product-id ) + (1.22 * sin (180 + heading))

      ask near-by-receptor
      [
        set ligand-bound [self] of myself
        set element-state get-receptor-element-state
        set color get-color
      ]
      update-molecule
      go-ligand-in-molecule product-id
    ]
   ]
end

; positioning of the ligand with respect to receptor
to go-ligand-in-molecule [xreceptor]
  set heading [heading] of xreceptor
  set xcor ([xcor] of xreceptor ) + (1.22 * cos heading)
  set ycor ([ycor] of xreceptor ) + (1.22 * sin (180 + heading))
end


; routine to define how syk reacts with phosphorylated receptors
to syk-and-phosphorylated-r [ rtype ]

  ask syks with [ site1-bound = nobody and site2-bound = nobody]
  [

    let rand-value random-float 100
    let near-by-molecules receptors-here with [phosphorylated? and protein-bound = nobody  and ((rtype = 1 and receptor-type = rtype and rand-value < rate-for-theme-9) or (rtype = 2 and receptor-type = rtype and rand-value < rate-for-theme-19))]
    if any? near-by-molecules
    [
      let near-by-molecule one-of near-by-molecules
      set  site1-bound [self] of near-by-molecule
      set element-state get-syk-element-state
      set color get-color
      ask turtles with [product-id = [product-id] of myself ]
      [
        set product-id [product-id] of near-by-molecule
      ]
      ;create-link-with near-by-molecule [ set hidden? true]
      go-syk-in-molecule product-id
      create-link-with near-by-molecule [ set hidden? true ]
      ask near-by-molecule
      [
        set protein-bound [self] of myself
        set element-state get-receptor-element-state
        set color get-color
      ]
      update-molecule
    ]
  ]

end

; positioning syk with respect to receptors
to go-syk-in-molecule [xreceptor]
  set heading [heading] of  xreceptor
  set xcor ([xcor] of xreceptor ) + (.8 * cos heading)
  set ycor ([ycor] of xreceptor ) + (.8 * sin (180 + heading))
end

; adjusting the position in go function
to go-on-receptor-in-molecule [xreceptor xadj]
  set heading [heading] of  xreceptor
  set xcor ([xcor] of xreceptor ) + ((xadj + 1.6 ) * cos heading)
  set ycor ([ycor] of xreceptor ) + ((xadj + 1.6 ) * sin (random-float 180 + heading))
end

; adjusting the position in go function
to go-on-ligand-in-molecule [xreceptor xadj ]
  set heading [heading] of  xreceptor
  set xcor ([xcor] of xreceptor ) + ((xadj + 1.22 ) * cos heading)
  set ycor ([ycor] of xreceptor ) + ((xadj + 1.22 ) * sin (random-float 180 + heading))
end


; adjusting the position in go function
to go-on-syk-in-molecule [xreceptor xadj]
  set heading [heading] of  xreceptor
  set xcor ([xcor] of xreceptor ) + ((xadj + .8 ) * cos heading)
  set ycor ([ycor] of xreceptor ) + ((xadj + .8 ) * sin (random-float 180 + heading))
end

; the main function for dissociation and reverse logic
to dissociate-and-reverse
  let unique-products  get-unique-product-id
  foreach unique-products
  [
    upid ->
    ;show "START UPID"
    ;print word "UPID: " upid
    ask one-of turtles with [ product-id = upid ]
    [
      let element self
      if is-receptor? element
      [
         reverse-logic-for-receptors
      ]
      if is-syk? element
      [
        reverse-logic-for-syks
      ]
      if is-ligand? element
      [
        ;show "before here ligand"
        ;reverse-logic-for-ligands
        ;show "after here ligand"
      ]
    ]
    ;show "END UPID"

  ]

end

to reverse-logic-for-receptors
;;in this function, myself = R under consideration for dissociation
  let processed? false
  if phosphorylated? or
  ligand-bound != nobody or
  protein-bound != nobody or
  not empty? receptor-bound
  [
    if protein-bound != nobody
    [

      let connected-syk protein-bound
      let me self
      if dissociate-receptor-and-syk?  connected-syk
      [
        ask link-with connected-syk [ die ]
        set protein-bound nobody
        set element-state get-receptor-element-state
        set color get-color
        let current-product-id product-id
        let new-product-id product-id
        ask connected-syk
        [
          ifelse site1-bound = [self] of myself
          [ set site1-bound nobody ]
          [ set site2-bound nobody ]

          set element-state get-syk-element-state
          set color get-color
        ]

        ifelse current-product-id = self
        [
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id
              ;set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]
        [
          set new-product-id self
          set product-id self

          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set product-id new-product-id
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id
              ; set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]
        set processed? true
      ]
    ]

    if ligand-bound != nobody and not processed?
    [
      ;show "before here 2"
      let me self
      let connected-ligand ligand-bound
      if dissociate-receptor-and-ligand?
      [
        ask link-with connected-ligand [ die ]
        set ligand-bound nobody
        set element-state get-receptor-element-state
        let current-product-id product-id
        let new-product-id product-id
        ask connected-ligand
        [
          set receptor-bound nobody
          ifelse ligand-state = "dimer"
          [
            ifelse l1 = self
            [ set element-state get-dimer-element-state
              set color get-color
              ask l2 [ set element-state get-dimer-element-state set color get-color ]
            ]
            [
              set element-state get-dimer-element-state
              set color get-color
              ask l1 [ set element-state get-dimer-element-state set color get-color ]
            ]

          ]
          [
            set element-state get-ligand-element-state
            set color get-color
          ]
        ]

        ifelse current-product-id = self
        [
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id
              ;set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]
        [
          set new-product-id self
          set product-id self

          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set product-id new-product-id
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id
              ; set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]
        set processed? true
        ;show "after here 3 else"
      ]
    ]

    if not empty? receptor-bound and not processed?
    [

      let connected-receptors  receptor-bound
      let me self
      let themes []
      if receptor-type = 1 and effective-link-count 1 > 0
      [ set themes lput "theme-2"  themes]
      if receptor-type = 1 and effective-link-count 2 > 0
      [ set themes lput "theme-13"  themes]
      if receptor-type = 2 and effective-link-count 1 > 0
      [ set themes lput "theme-13"  themes]
      if receptor-type = 2 and effective-link-count 2 > 0
      [ set themes lput "theme-12"  themes]
      let theme-rates get-reverse-theme-rates themes
      let theme-list  item 0 theme-rates
      let rate-list  item 1 theme-rates
      let transform-list? will-transform? rate-list
      if member? true transform-list?
      [
        let pos position true transform-list?
        let selected-theme item pos theme-list
        let rtype  1
        if receptor-type = 1 and selected-theme = "theme-2"
        [ set rtype  1 ]
        if receptor-type = 1 and selected-theme = "theme-13"
        [ set rtype  2 ]
        if receptor-type = 2 and selected-theme = "theme-12"
        [ set rtype  2 ]
        if receptor-type = 2 and selected-theme = "theme-13"
        [ set rtype  1 ]
      ;if ( protein-bound = nobody or [site1-bound] of protein-bound != one-of receptor-bound or [site2-bound] of protein-bound != one-of receptor-bound ) ;; making sure that the splitting R is not connected to the same Syk or LL, if Syk or LL are present
      ;;if protein-bound = nobody and ligand-bound = nobody and dissociate-receptor-and-receptor? ;; checking to see whether any ligand or syk is attached to this splitting R
        ;show "before here 4"
        ;show self
        ;show connected-receptors
        ;show me
        ;show "before here 4b"
        let current-product-id product-id
        let new-product-id current-product-id
        set receptor-bound [] ;; un-dimerise myself
        let con-receptors []
        foreach connected-receptors
        [ c-r ->
          ifelse [receptor-type] of c-r != rtype
          [ set receptor-bound lput c-r receptor-bound]
          [ set con-receptors  lput c-r con-receptors ]
        ]
        __set-line-thickness -4
        set color get-color

        foreach con-receptors  ;; make the R-R link die
        [
          c-r ->
          ask link-with c-r [ die ]
          ask c-r
          [
;            ask my-links
;            [ die ]
            ifelse  member? me receptor-bound ; if this particular connected receptor is still part of the list of connected receptors of self
            [
              set receptor-bound remove me receptor-bound ;;remove this c-r from the list
              if empty? receptor-bound
              [
                __set-line-thickness -4 ;;when c-r's list is completely empty, reset appearance of outline border
                                        ;set color get-color
              ]
            ]
            [ show "not member"]
          ]

        ]

        ifelse current-product-id = self
        [
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id and receptor-type != rtype]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id and receptor-type != rtype])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id

              ;set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]
        [
          set new-product-id self
          set product-id self
          if any? other turtles with [nw:distance-to me != false and product-id = current-product-id]
          [
            ask other turtles with [nw:distance-to me != false and product-id = current-product-id]
            [
              set product-id new-product-id
              set molecule get-molecule-name product-id
            ]
          ]
          if any? other turtles with [nw:distance-to me = false and product-id = current-product-id]
          [
            ifelse any? receptors with [nw:distance-to me = false and product-id = current-product-id and receptor-type != rtype]
            [ set new-product-id ([self] of one-of receptors with [nw:distance-to me = false and product-id = current-product-id and receptor-type != rtype])]
            [ set new-product-id ([self] of one-of turtles with [nw:distance-to me = false and product-id = current-product-id])]

            ask other turtles with [nw:distance-to me = false and product-id = current-product-id]
            [
              set product-id new-product-id
              ;set molecule get-molecule-name product-id
            ]
            ask other turtles with [nw:distance-to me = false and product-id = new-product-id]
            [
              set molecule get-molecule-name product-id
            ]
          ]
          update-molecule
        ]

        set processed? true
        set color get-color ;;change from yellow dimers to back to the color palette
        ;show "after here 4b"

      ]
    ]

    if phosphorylated? and protein-bound = nobody and not processed?
    [
      ;show "before here 5"
      unphosphorylation-process
      ;show "after here 5"
    ]
    ;show "after here  THE END of reverse-R"
  ]

end

; reverse reaction logic implementation for all reactions
to  unphosphorylation-process
  ;show "before here 6"
  let already-set? false
  ifelse not single-reverse-rate-for-phosphorylation?
  [
    let themes (list "theme-1" "theme-5" "theme-10")
    if element-state = "R1"
    [ ;show "before here 7"
      set themes (list "theme-1"  "theme-10")
      ;show "after here 7"
    ]
    if receptor-type = 2
    [
      set themes (list "theme-11" "theme-15" "theme-20")
      if element-state = "RX1"
      [ ;show "before here 7"
        set themes (list "theme-11"  "theme-20")
        ;show "after here 7"
      ]
    ]

    let theme-rates get-reverse-theme-rates themes
    let theme-list  item 0 theme-rates
    let rate-list  item 1 theme-rates
    set rate-list (update-rate-list rate-list)   ; to reduce the rate of dephosphorylation within clusters according to size of cluster
    let transform-list? will-transform? rate-list
    if member? "theme-1" theme-list
    [
      ;show "before here 8"
      let pos position "theme-1" theme-list
      if (item pos transform-list?)
      [

        ;show "before here 9"
        phosphorylate false
        set  already-set? true
        ;show "after here 9"
      ]
      ;show "after here 8"
    ]
    if member? "theme-5" theme-list and not already-set?
    [
      ;show "before here 10"
      let pos position "theme-5" theme-list
      if (item pos transform-list? and ligand-bound != nobody)
      [
        ;show "before here 11"
        phosphorylate false
        set  already-set? true
        ;show "after here 11"
      ]
      ;show "after here 10"
    ]
    if member? "theme-10" theme-list and not already-set?
    [
      ;show "before here 12"
      let pos position "theme-10" theme-list
      if (item pos transform-list? and protein-bound != nobody)
      [
        ;show "before here 13"
        phosphorylate false
        ;show "after here 13"
      ]
      ;show "after here 12"
    ]
    if member? "theme-11" theme-list
    [
      ;show "before here 8"
      let pos position "theme-11" theme-list
      if (item pos transform-list?)
      [

        ;show "before here 9"
        phosphorylate false
        set  already-set? true
        ;show "after here 9"
      ]
      ;show "after here 8"
    ]
    if member? "theme-15" theme-list and not already-set?
    [
      ;show "before here 10"
      let pos position "theme-15" theme-list
      if (item pos transform-list? and ligand-bound != nobody)
      [
        ;show "before here 11"
        phosphorylate false
        set  already-set? true
        ;show "after here 11"
      ]
      ;show "after here 10"
    ]
    if member? "theme-20" theme-list and not already-set?
    [
      ;show "before here 12"
      let pos position "theme-20" theme-list
      if (item pos transform-list? and protein-bound != nobody)
      [
        ;show "before here 13"
        phosphorylate false
        ;show "after here 13"
      ]
      ;show "after here 12"
    ]
  ]
  [
    if random-float 100 < single-rate-of-dephosphorylation
    [
      phosphorylate false
    ]
  ]
  ;show "after here 6"

end

to-report get-reverse-theme-rates [ themes ]
  let theme-list []
  let rate-list []
  foreach themes
  [ theme ->
    if (runresult theme)
    [
      set theme-list lput theme theme-list
      let temp (word "reverse-rate-for-" theme)
      set rate-list lput (runresult temp) rate-list
    ]
  ]
  report (list theme-list rate-list)
end

to-report update-rate-list [ xrate-list ]
  let new-rate-list []
  foreach xrate-list
  [ rate ->
    let speed-reducer (1 - base-reduction)
    ifelse cluster-id != nobody
    [
      let count-receptors count receptors with [cluster-id = [cluster-id] of myself]
      ifelse count-receptors < 4
      [ set speed-reducer 1 ]
      [ ;
        let diff (count-receptors - 4 )
        let times 0
        while [ times < diff ]
        [
          set times (times + 1)
          set speed-reducer (1 - (base-reduction + (times * step-reduction)))
        ]
      ]
    ]
    [
      set speed-reducer 1
    ]
    set new-rate-list lput (rate * speed-reducer) new-rate-list
  ]
  report new-rate-list
end

to-report get-unique-product-id
  let products [product-id] of turtles
  let unique-products []
  foreach products
  [ pid ->
    if not member? pid unique-products
    [
      set unique-products lput pid unique-products
    ]
  ]
  report unique-products
end

to-report get-unique-products
  let products [product-id] of turtles
  let unique-products []
  foreach products
  [ pid ->
    if not member? pid unique-products and (count turtles with [product-id = pid] > 1)
    [
      set unique-products lput pid unique-products
    ]
  ]
  report unique-products
end

to-report dissociate-receptor-and-syk? [xsyk]
  if [ site1-bound] of xsyk != nobody and [site2-bound] of xsyk != nobody    ; S2
  [
    let rand-value (random-float 100 )
    if (rand-value < reverse-rate-for-theme-4 and theme-4 and receptor-type = 1) or (rand-value < reverse-rate-for-theme-14 and theme-14 and receptor-type = 2)
    [report true ]
  ]
  if ([ site1-bound ] of xsyk != nobody and [site2-bound] of xsyk = nobody) or
     ([ site1-bound ] of xsyk = nobody and [site2-bound] of xsyk != nobody)   ; S1
  [
    let rand-value (random-float 100 )
    if (rand-value < reverse-rate-for-theme-9 and theme-9 and receptor-type = 1) or (rand-value < reverse-rate-for-theme-19 and theme-19 and receptor-type = 2)
    [ report true]
  ]
  report false
end


to-report dissociate-receptor-and-ligand?
  let rand-value (random-float 100 )
  if (rand-value < reverse-rate-for-theme-8 and theme-8 and receptor-type = 1) or (rand-value < reverse-rate-for-theme-18 and theme-18 and receptor-type = 2)
  [ report true]
  report false
end

to-report dissociate-receptor-and-receptor?
  if random-float 100 < reverse-rate-for-theme-2 and theme-2
  [ report true]
  report false
end


to reverse-logic-for-syks

  let processed? false
  if kinectically-active? or site1-bound != nobody or  site2-bound != nobody
  [
    ;show "before here 1S"
    ifelse kinectically-active? ; S3
    [
      if site1-bound != nobody and  site2-bound != nobody and make-syk-inactive?
      [
        set kinectically-active? false
        set element-state get-syk-element-state
        set color get-color
        update-molecule
        set processed? true
      ]
    ]
    [
      ifelse site1-bound != nobody and  site2-bound != nobody
      [
        ; selecting the receptor connected to site1 or site2 randomly.
        ; the following command select site1 or site2 with 50% chance
        let connected-receptor  site1-bound
        let current-product-id product-id
        let new-product-id current-product-id
        let lead [self] of connected-receptor
        ;show "before here 2SA TEST"
        if random 100 < 50
        [ set connected-receptor  site2-bound]
        ;show "before here 2S"
        ;show connected-receptor
        if dissociate-one-site? connected-receptor
        [
          ask link-with connected-receptor [ die ]
          ;show "after here 2S"
          ask connected-receptor
          [
            ;show "before here 3S"
            set protein-bound nobody
            set element-state get-receptor-element-state
            set color get-color
            ;show "after here 3S"
          ]
          ifelse connected-receptor = site1-bound
          [ set site1-bound nobody ]
          [ set site2-bound nobody ]

          set element-state get-syk-element-state
          set color get-color

          ifelse current-product-id = lead
          [
            if any? other turtles with [nw:distance-to lead = false and product-id = current-product-id]
            [
              ifelse any? receptors with [nw:distance-to lead = false and product-id = current-product-id]
              [ set new-product-id ([self] of one-of receptors with [nw:distance-to lead = false and product-id = current-product-id])]
              [ set new-product-id ([self] of one-of turtles with [nw:distance-to lead = false and product-id = current-product-id])]

              ask other turtles with [nw:distance-to lead = false and product-id = current-product-id]
              [
                set product-id new-product-id
              ]
              if nw:distance-to lead = false
              [
                set product-id new-product-id
              ]
              ask other turtles with [nw:distance-to lead = false and product-id = new-product-id]
              [
                set molecule get-molecule-name product-id
              ]

            ]
            if any? other turtles with [nw:distance-to lead != false and product-id = current-product-id]
            [
              ask other turtles with [nw:distance-to lead != false and product-id = current-product-id]
              [
                set molecule get-molecule-name product-id
              ]
            ]
            update-molecule
          ]
          [
            set new-product-id lead
            set product-id self
            if any? other turtles with [nw:distance-to lead != false and product-id = current-product-id]
            [
              ask other turtles with [nw:distance-to lead != false and product-id = current-product-id]
              [
                set product-id new-product-id
                ; set molecule get-molecule-name product-id
              ]
              if nw:distance-to lead != false
              [
                set product-id new-product-id
              ]
            ]
            if any? other turtles with [nw:distance-to lead = false and product-id = current-product-id]
            [
              ifelse any? receptors with [nw:distance-to lead = false and product-id = current-product-id]
              [ set new-product-id ([self] of one-of receptors with [nw:distance-to lead = false and product-id = current-product-id])]
              [ set new-product-id ([self] of one-of turtles with [nw:distance-to lead = false and product-id = current-product-id])]

              ask other turtles with [nw:distance-to lead = false and product-id = current-product-id]
              [
                set product-id new-product-id
                ; set molecule get-molecule-name product-id
              ]
              if nw:distance-to lead = false
              [
                set product-id new-product-id
              ]
              ask other turtles with [nw:distance-to lead = false and product-id = new-product-id]
              [
                set molecule get-molecule-name product-id
              ]
            ]
            update-molecule
          ]
        ]
      ]
      [

        if ((site1-bound = nobody and  site2-bound != nobody) or
          (site1-bound != nobody and  site2-bound = nobody))
        [
          let connected-receptor nobody
          ifelse site1-bound != nobody [ set connected-receptor site1-bound ]
          [if site2-bound != nobody [ set connected-receptor site2-bound ]]
          if detach-syk? connected-receptor
          [
            if connected-receptor = site1-bound [ set site1-bound  nobody ]
            if connected-receptor = site2-bound [ set site2-bound  nobody ]
            set element-state get-syk-element-state
            set color get-color
            set product-id self
            ;show "before here 7S"
            ask link-with connected-receptor [ die ]
            ;show "after here 7S"
            ;show "before here 8S"
            ask connected-receptor
            [
              ;show "before here 8S inside the loop"
              set protein-bound nobody
              if ligand-bound = nobody and empty? receptor-bound
              [
                set product-id self
              ]
              set element-state get-receptor-element-state
              set color get-color
              update-molecule
              ;show "after here 8S inside the loop"
            ];show "after here 8S"
            update-molecule
          ]
        ]
        ;show "after here 1SB"
      ]
    ]
  ]
  ;show "after here 1S THE END"
end

to-report make-syk-inactive?
  if random-float 100 < reverse-rate-for-theme-3 and theme-3
  [
    report true
  ]
  report false
end

to-report dissociate-one-site? [ con-receptor ]
  let rtype [receptor-type] of con-receptor
  let rand-value random-float 100
  if  (rand-value < reverse-rate-for-theme-4 and theme-4 and rtype = 1) or (rand-value < reverse-rate-for-theme-14 and theme-14 and rtype = 2)
  [
    report true
  ]
  report false
end

to-report detach-syk? [ con-receptor ]
  let rtype [receptor-type] of con-receptor
  let rand-value random-float 100
  if (rand-value < reverse-rate-for-theme-9 and theme-9 and rtype = 1) or (rand-value < reverse-rate-for-theme-19 and theme-19 and rtype = 2)
  [
    report true
  ]
  report false
end

to reverse-logic-for-ligands
  let processed? false
  ifelse ligand-state = "dimer"
  [
    if [receptor-bound] of l1 != nobody or [receptor-bound] of l2 != nobody
    [
      if [receptor-bound] of l1 != nobody and [receptor-bound] of l2 != nobody
      [
        let connected-receptor [receptor-bound] of l1
        if random 100 < 50
        [ set connected-receptor [receptor-bound] of l2]
        if dissociate-one-receptor? connected-receptor
        [
          if [receptor-bound] of l1 = connected-receptor
          [ ask l1 [ ask link-with connected-receptor [ die ] ] ]
          if [receptor-bound] of l2 = connected-receptor
          [ ask l2 [ ask link-with connected-receptor [ die ] ] ]
          ask connected-receptor
          [
            set ligand-bound nobody
            if protein-bound = nobody and empty? receptor-bound
            [
              set product-id self
            ]
            set element-state get-receptor-element-state
            set color get-color
          ]
          ifelse product-id = [product-id] of connected-receptor
          [
            ifelse connected-receptor =  [receptor-bound] of l1
            [
              ask l1
              [ set receptor-bound nobody
                set product-id [receptor-bound] of l2
              ]
              ask l2 [ set product-id receptor-bound]
            ]
            [
              ask l2
              [ set receptor-bound nobody
                set product-id [receptor-bound] of l1
              ]
              ask l1 [ set product-id receptor-bound]
            ]
            set element-state get-dimer-element-state
            set color get-color
          ]
          [
            ifelse connected-receptor =  [receptor-bound] of l1
            [
              ask l1 [
                set receptor-bound nobody
              ]
            ]
            [
              ask l2 [
                set receptor-bound nobody
              ]
            ]
          ]
          ask l1 [
            set element-state get-dimer-element-state
            set color get-color
          ]
          ask l2 [
            set element-state get-dimer-element-state
            set color get-color
          ]
          update-molecule
          ask connected-receptor [ update-molecule ]
          set processed? true
        ]
      ]

      if (([receptor-bound] of l1 != nobody and [receptor-bound] of l2 = nobody) or
        ([receptor-bound] of l1 = nobody and [receptor-bound] of l2 != nobody))  and not processed?
      [
        let connected-receptor nobody
        ifelse [receptor-bound] of l1 != nobody [ ask l1 [ set connected-receptor receptor-bound set receptor-bound  nobody] ]
        [ if [receptor-bound] of l2 != nobody [ ask l2 [ set connected-receptor receptor-bound set receptor-bound  nobody]]]
        if dissociate-one-receptor? connected-receptor
        [
          ask l1
          [
            set product-id self
            set element-state get-dimer-element-state
            set color get-color
          ]
          ask l2
          [
            set product-id [product-id] of l1
            set element-state get-dimer-element-state
            set color get-color
          ]
          ask connected-receptor
          [
            set ligand-bound nobody
            if protein-bound = nobody and empty? receptor-bound
            [
              set product-id self
            ]
            set element-state get-receptor-element-state
            set color get-color
            update-molecule
          ]
          update-molecule
          set processed? true
        ]
      ]
    ]
  ]
  [
    if receptor-bound != nobody or not empty? ligand-bound
    [
      if receptor-bound != nobody
      [
        let connected-receptor receptor-bound
        if dissociate-one-receptor? connected-receptor
        [
          set receptor-bound nobody
          ask link-with connected-receptor [ die ]
          set element-state get-ligand-element-state
          set color get-color
          ifelse empty? ligand-bound [ set product-id self ]
          [ask turtles with [ product-id = [product-id] of myself] [set product-id [self] of myself ]]
          ask connected-receptor
          [
            set ligand-bound nobody
            if protein-bound = nobody and empty? receptor-bound
            [
              set product-id self
            ]
            set element-state get-receptor-element-state
            set color get-color
            update-molecule
          ]
          update-molecule
          set processed? true
        ]
      ]
      if not empty? ligand-bound and not processed?
      [
        let connected-ligands  ligand-bound
        let me self
        if receptor-bound = nobody and dissociate-ligands?
        [
          let current-product-id [product-id] of one-of ligand-bound
          let new-product-id current-product-id
          if current-product-id = self
          [
            set new-product-id [self] of one-of ligand-bound
          ]
          set ligand-bound []
          foreach connected-ligands
          [
            c-l ->
            ask link-with c-l [ die ]
            ask c-l
            [
              ifelse  member? me ligand-bound
              [ set ligand-bound remove me ligand-bound ]
              [ show "not member ligand" ]
            ]

          ]
          ask turtles with [product-id = current-product-id ]
          [
            set product-id new-product-id
          ]
          set product-id self
          set molecule get-molecule-name product-id
          ask turtles with [product-id = new-product-id ]
          [
            set molecule get-molecule-name product-id
          ]
          set processed? true
        ]
      ]

    ]
  ]

end

to-report dissociate-one-receptor? [con-receptor]
  let rtype ([receptor-type] of con-receptor)
  let rand-value random-float 100
  if (rand-value < reverse-rate-for-theme-8 and theme-8 and rtype = 1) or (rand-value < reverse-rate-for-theme-18 and theme-18 and rtype = 2)
  [
    report true
  ]
  report false
end

to-report  dissociate-ligands?
  if random-float 100 < reverse-rate-for-theme-6 and theme-6
  [
    report true
  ]
  report false
end
;----------------------------------------------------------------------------
; Output csv file
;----------------------------------------------------------------------------
to write-into-file
  if csv-output? [
  let file-name (word "Reporting.csv" )
  let need-header? true
  let header ""
  let line ""
  let product-num 0
  let needed-values [ "TotPhosReceptors" "ClusterNumber" "MeanCluster" "TotPhosReceptorsInCluster" "TotPhosReceptorsOutCluster" "TotalSykInCluster" "TotSykOutCluster" ]
  if file-exists? file-name [ set need-header? false ]
  file-open file-name
  if need-header? = true [
    set header "RunNumber, TimeStep,"
    foreach needed-values
    [ value ->
      set header (word header "," value)
    ]
    file-print header
  ]
  set line (word behaviorspace-run-number "," ticks "," tot-phos-receptors ","  cluster-count "," mean-size ","  receptors-in-cluster "," receptors-out-cluster "," double-syks-in-cluster "," double-syks-out-cluster)
  file-print line
    file-close ]
end

to set-cluster-id

  if any? turtles with [count receptors with [product-id = [product-id] of myself] <= 2]
  [
    ask turtles with [count receptors with [product-id = [product-id] of myself] <= 2]
    [ set cluster-id nobody ]
  ]

  if any? turtles with [count receptors with [product-id = [product-id] of myself] > 2 and product-id = self]
  [
    ask turtles with [count receptors with [product-id = [product-id] of myself] > 2 and product-id = self]
    [
      ifelse cluster-id != nobody
      [
        ask turtles with [product-id = [product-id] of myself]
       [
          set cluster-id [cluster-id] of myself
       ]
      ]
      [
        ifelse any? receptors with [ cluster-id != nobody and product-id = [product-id] of myself ]
        [
          let existing-cluster one-of receptors with [ cluster-id != nobody and product-id = [product-id] of myself ]
          set cluster-id [cluster-id] of existing-cluster
        ]
        [
          set cluster-id [who] of product-id
        ]
        ask turtles with [product-id = [product-id] of myself]
        [
          set cluster-id [cluster-id] of myself
        ]
      ]
    ]
  ]

end

to-report cluster-number
  set cluster-count 0
  let unique-products []
  set size-of-cluster []


  ask turtles
  [
    let size-cluster count receptors with [product-id = [product-id] of myself]
    if is-receptor? self
    [
      if not member? product-id unique-products and ( size-cluster > 2 )
      [
        set cluster-count (cluster-count + 1)
        set size-of-cluster lput size-cluster size-of-cluster
        set unique-products lput product-id unique-products
      ]
    ]
    if is-syk? self
    [
      if not member? product-id unique-products and ( size-cluster > 2 )
      [
        set cluster-count (cluster-count + 1)
        set size-of-cluster lput size-cluster size-of-cluster
        set unique-products lput product-id unique-products
      ]
    ]
    if is-ligand? self
    [
      ifelse ligand-state = "dimer"
      [
        if not member? product-id unique-products and ( size-cluster > 2 )
        [
          let count-dimer count ligands with [product-id = [product-id] of myself and ligand-state = "dimer"]
          set cluster-count (cluster-count + 1)
          set size-of-cluster lput (size-cluster - count-dimer) size-of-cluster
          set unique-products lput product-id unique-products
        ]
      ]
      [
        if not member? product-id unique-products and ( size-cluster > 2 )
        [
          set cluster-count (cluster-count + 1)
          set size-of-cluster lput size-cluster size-of-cluster
          set unique-products lput product-id unique-products
        ]
      ]
    ]
  ]
  set total-size 0
  foreach size-of-cluster
  [
    sc -> set total-size total-size + sc
  ]
  set mean-size 0
  if cluster-count > 0
  [ set  mean-size total-size / cluster-count ]
  report (list cluster-count mean-size )
end




to get-count-with-double-bound-s
  set count-group-list-v3 []
  set counter-list-v3 []
  let unique-products remove-duplicates [product-id] of syks with [ site1-bound != nobody and  site2-bound != nobody]
  foreach unique-products
  [ pid ->
    let s-count count syks with [ product-id = pid and site1-bound != nobody and  site2-bound != nobody]
    let combo (word s-count "S")
    if not member? combo count-group-list-v3
    [ set count-group-list-v3  lput combo count-group-list-v3
      set counter-list-v3  lput 0 counter-list-v3
    ]
    let index position combo count-group-list-v3
    let new-count ( item index counter-list-v3 + 1)
    set counter-list-v3 replace-item index counter-list-v3 new-count
  ]
  ;print count-group-list-v3
  ;print counter-list-v3
end

to get-count-with-double-bound-s-with-two-r
  set count-group-list-v4 []
  set counter-list-v4 []
  let unique-products remove-duplicates [product-id] of syks with [ site1-bound != nobody and  site2-bound != nobody]
  foreach unique-products
  [ pid ->
    let s-count count syks with [ product-id = pid and site1-bound != nobody and  site2-bound != nobody]
    let combo (word s-count "S")
    if not member? combo count-group-list-v3
    [ set count-group-list-v3  lput combo count-group-list-v3
      set counter-list-v3  lput 0 counter-list-v3
    ]
    let index position combo count-group-list-v3
    let new-count ( item index counter-list-v3 + 1)
    set counter-list-v3 replace-item index counter-list-v3 new-count
  ]
  ;print count-group-list-v3
  ;print counter-list-v3
end

to get-count-of-groups
  set count-group-list []
  set counter-list []
  let unique-products remove-duplicates [product-id] of receptors with [ count receptors with [ product-id = [product-id] of myself ] > 1  and
  count syks with [ product-id = [product-id] of myself and site1-bound != nobody and  site2-bound != nobody] > 0]
  foreach unique-products
  [ pid ->
    let s-count count syks with [ product-id = pid and site1-bound != nobody and  site2-bound != nobody]
    let r-count count receptors with [ product-id = pid ]
    let combo (word r-count "R"  s-count "S")
    if not member? combo count-group-list
    [ set count-group-list lput combo count-group-list
      set counter-list lput 0 counter-list
    ]
    let index position combo count-group-list
    let new-count ( item index counter-list + 1)
    set counter-list replace-item index counter-list new-count
  ]
  ;print count-group-list
  ;print counter-list

end

to get-count-of-groups-v2
  set count-group-list-v2 []
  set counter-list-v2 []
  let unique-products remove-duplicates [product-id] of receptors with [ count receptors with [ product-id = [product-id] of myself ] > 1  and
  count syks with [ product-id = [product-id] of myself] > 0]
  foreach unique-products
  [ pid ->
    let s3-count count syks with [ product-id = pid and kinectically-active? and site1-bound != nobody and  site2-bound != nobody]
    let s2-count count syks with [ product-id = pid and (not kinectically-active?) and site1-bound != nobody and  site2-bound != nobody]
    let s1-count count syks with [ product-id = pid and (not kinectically-active?) and site1-bound != nobody or  site2-bound != nobody]
    let r-count count receptors with [ product-id = pid ]
    let combo (word r-count "R"  s3-count "S3" s2-count "S2" s1-count "S1")
    if not member? combo count-group-list-v2
    [ set count-group-list-v2 lput combo count-group-list-v2
      set counter-list-v2 lput 0 counter-list-v2
    ]
    let index position combo count-group-list-v2
    let new-count ( item index counter-list-v2 + 1)
    set counter-list-v2 replace-item index counter-list-v2 new-count
  ]

  ;print count-group-list-v2
  ;print counter-list-v2
end





to-report receptors-in-cluster
  report count receptors with [ phosphorylated? and cluster-id != nobody  ] / r-absolute * 100
end

to-report receptors-out-cluster
  report count receptors with [ phosphorylated? and  cluster-id = nobody ] / r-absolute * 100
end


to-report double-syks-in-cluster
  report count syks with [ site1-bound != nobody and site2-bound != nobody and  cluster-id != nobody] / s-absolute * 100
end

to-report double-syks-out-cluster
  report count syks with [ site1-bound != nobody and site2-bound != nobody and   cluster-id = nobody ] / s-absolute * 100
end

to-report total-double-bound-syks
  report (count syks with [site1-bound != nobody and site2-bound != nobody]) / s-absolute * 100
end

to-report total-single-bound-syks
  report ((count syks with [site1-bound != nobody and site2-bound = nobody]) + (count syks with [site1-bound = nobody and site2-bound != nobody])) / s-absolute * 100
end

to-report total-none-bound-syks
  report (count syks with [site1-bound = nobody and site2-bound = nobody]) / s-absolute * 100
end


to-report is-steady-state?
  ifelse check-steady-state? [
  set time-step-counter (time-step-counter + 1)
  foreach element-scheme
  [ element ->
    let pos position element element-scheme
    let element-state-count-values item pos element-state-counts-list
    let coeff-of-variance-values item pos coeff-of-variance-list
    let current-count count turtles with [element-state = element ]
    set element-state-count-values  fput current-count element-state-count-values
    set element-state-counts-list  replace-item pos element-state-counts-list element-state-count-values
    if (time-step-counter mod step-size) = 0
    [
      if (length element-state-count-values) >= consecutive-states
      [
        let recent-counts sublist element-state-count-values 0 consecutive-states
        let element-state-mean mean recent-counts
        let element-state-stddev standard-deviation recent-counts
        ifelse element-state-mean = 0
        [ let mean-zero item pos mean-zero-list
          set mean-zero fput 0 mean-zero
          if length mean-zero >= consecutive-zero
          [ set steady-state-checker replace-item pos steady-state-checker true ]
          set mean-zero-list replace-item pos mean-zero-list mean-zero
        ]
        [
          set mean-zero-list replace-item pos mean-zero-list []
          let coeff-of-var element-state-stddev /  element-state-mean
          set coeff-of-variance-values fput coeff-of-var coeff-of-variance-values
          set coeff-of-variance-list replace-item pos coeff-of-variance-list coeff-of-variance-values
          if length coeff-of-variance-values >= consecutive-states
          [
            let no-diff 0
            foreach sublist coeff-of-variance-values 0 consecutive-states
            [ cov ->
              if cov <= epsilon
              [
                set no-diff no-diff + 1
              ]
            ]
            if no-diff >= consecutive-states
            [set steady-state-checker replace-item pos steady-state-checker true]
          ]
        ]
      ]
    ]
  ]
  if member? false steady-state-checker[ report false]
    report true ] [report false ]
end

to-report count-rrs-molecules
  report (length remove-duplicates [product-id] of syks with [ site1-bound != nobody and site2-bound != nobody and count syks with [ product-id = [product-id] of myself ] = 1 and count receptors with [ product-id = [product-id] of myself ] = 2 ]) / S * 100
end

to-report count-rs-in-rrs-molecules
  report (length remove-duplicates [product-id] of syks with [ site1-bound != nobody and site2-bound != nobody and count syks with [ product-id = [product-id] of myself ] = 1 and count receptors with [ product-id = [product-id] of myself ] = 2 ]) / R * 100 * 2
end

to-report count-s2
  report (count syks with [ site1-bound != nobody and site2-bound != nobody ] ) / S * 100
end

to-report count-s1
  report count syks with [ (site1-bound != nobody and site2-bound = nobody)  or (site1-bound = nobody and site2-bound != nobody)] / S * 100
end

to-report count-s0
  report ( count syks with [ site1-bound = nobody and site2-bound = nobody ] ) / S * 100
end

to-report double-syks-in
  report double-syks-in-cluster / S * 100
end

to-report double-syks-out
  report double-syks-out-cluster / S * 100
end

to-report tot-phos-receptors
  ; report count receptors with [element-state = "R1" or element-state = "R3" or element-state = "R4" or element-state = "R5"  ]
  report count receptors with [ phosphorylated? ] / R * 100
end

to-report r-dim-separate [rtype]
  let denom R
  if rtype = 1
  [
    set denom R
  ]
  if rtype = 2
  [
    set denom RX
  ]
  if denom = 0
  [
    report 0
  ]
  report count receptors with [ not empty? receptor-bound and receptor-type = rtype] / denom * 100
end

to-report r-phos-separate [rtype]
  let denom R
  if rtype = 1
  [
    set denom R
  ]
  if rtype = 2
  [
    set denom RX
  ]
  if denom = 0
  [
    report 0
  ]
  report count receptors with [ phosphorylated? and receptor-type = rtype] / denom * 100
end

to-report r-dis [rtype]
  let denom R
  if rtype = 1
  [
    set denom R
  ]
  if rtype = 2
  [
    set denom RX
  ]
  if denom = 0
  [
    report 0
  ]
  report count receptors with [ empty? receptor-bound and protein-bound = nobody and ligand-bound = nobody and receptor-type = rtype] / denom * 100
end

to count-molecule-with-syk
  set molecule-with-syks-list []
  set counter-molecule-with-syk-list []
  if any? syks with [ site1-bound != nobody and site2-bound != nobody ]
  [
    let molecule-with-max-syk [product-id] of syks with [site1-bound != nobody and site2-bound != nobody] with-max [ count syks with [ product-id = [product-id] of myself ]]
    if not empty? molecule-with-max-syk
    [
      let pid one-of molecule-with-max-syk
      let max-num count syks with [ product-id = pid ]
      foreach (range max-num)
      [ counter ->
        set molecule-with-syks-list lput (word (counter + 1) "S") molecule-with-syks-list
        let molecule-count length remove-duplicates [product-id] of syks with [ count syks with [ product-id = [product-id] of myself ] = (counter + 1) ]
        set counter-molecule-with-syk-list lput molecule-count counter-molecule-with-syk-list
      ]
    ]
  ]

end


to-report exact-rrs-count
  let exact-rrs 0
  if any? syks with [ site1-bound != nobody and site2-bound != nobody and count syks with [product-id = [product-id] of myself] = 1]
  [
    let uniq-pid remove-duplicates [product-id] of syks with [ site1-bound != nobody and site2-bound != nobody and count syks with [product-id = [product-id] of myself] = 1 ]
    foreach uniq-pid
    [ upid ->
      if count receptors with [ product-id = upid ] = 2 and count ligands with [ product-id = upid ] = 0
      [
        set exact-rrs (exact-rrs + 1 )
      ]
    ]
  ]
  report exact-rrs
end


to count-molecule-with-receptors

  set molecule-with-receptors-list []
  set counter-molecule-with-receptor-list []
  if any? receptors with [ count receptors with [ product-id = [product-id] of myself ] >= 2 ]
  [
    let molecule-with-max-receptor [product-id] of receptors with [count receptors with [product-id = [product-id] of myself] >= 2] with-max [ count receptors with [ product-id = [product-id] of myself ]]
    if not empty? molecule-with-max-receptor
    [
      let pid one-of molecule-with-max-receptor
      let max-num count receptors with [ product-id = pid ]
      foreach (range 2 (max-num + 1))
      [ counter ->
        let molecule-count length remove-duplicates [product-id] of receptors with [ count receptors with [ product-id = [product-id] of myself ] = counter ]
        if molecule-count > 0
        [
          set molecule-with-receptors-list lput (word counter "R") molecule-with-receptors-list
          set counter-molecule-with-receptor-list lput molecule-count counter-molecule-with-receptor-list
        ]
      ]
    ]
  ]

end


to count-molecule-with-receptors-for-hist
  set counter-receptor-list []
  if any? receptors with [ count receptors with [ product-id = [product-id] of myself ] >= 2 ]
  [
    let uniq-pid remove-duplicates [product-id] of receptors with [ count receptors with [ product-id = [product-id] of myself ] >= 2 ]
    foreach uniq-pid
    [ upid ->
      let count-of-receptor count receptors with [ product-id = upid ]
      set counter-receptor-list lput count-of-receptor counter-receptor-list
    ]
  ]

end


to-report count-of-receptors [req-count]
  report item (req-count - 2) counter-molecule-with-receptor-list
end

to count-molecule-with-receptors-dict
  set tot-r-dict table:make
  if any? receptors with [ count receptors with [ product-id = [product-id] of myself ] >= 2 ]
  [
    let molecule-with-max-receptor [product-id] of receptors with [count receptors with [product-id = [product-id] of myself] >= 2] with-max [ count receptors with [ product-id = [product-id] of myself ]]
    if not empty? molecule-with-max-receptor
    [
      let pid one-of molecule-with-max-receptor
      let max-num count receptors with [ product-id = pid ]
      foreach (range 2 (max-num + 1))
      [ counter ->
        ; let x (word counter "R")
        let molecule-count length remove-duplicates [product-id] of receptors with [ count receptors with [ product-id = [product-id] of myself ] = counter ]
        if molecule-count > 0
        [ table:put tot-r-dict (word counter "R") molecule-count ]
        ;table:put tot-r-dict molecule-count
      ]
    ]
  ]

end



to  write-cluster-characteristics
  let file-name "cluster-characteristics-extra.csv"
  file-open file-name
  ; file-print "RunNo., Ticks, ClusterID, MeanClusterCoefficient, MeanDegree, MinDegree, MaxDegree, CountTurtleWithMinDegree, CountTurtleWithMaxDegree, MeanBetween, MinBetween, MaxBetween, CountTurtleWithMinBetween, CountTurtleWithMaxBetween, Modularity, MEanPageRank "
  let uniq-cid []
  if any? turtles with [cluster-id != nobody]
  [
    set uniq-cid remove-duplicates [cluster-id] of turtles with [cluster-id != nobody]
  ]
  foreach uniq-cid
  [ cid ->
    let line (word behaviorspace-run-number "," ticks "," cid "," mean [nw:clustering-coefficient ] of turtles with [ cluster-id = cid ] "," mean [length [self] of link-neighbors] of turtles with [ cluster-id = cid ])
    set line ( word line "," min [length [self] of link-neighbors] of turtles with [ cluster-id = cid ] "," max [length [self] of link-neighbors] of turtles with [ cluster-id = cid ])
    set line ( word line "," count turtles with [ cluster-id = cid] with-min [[length [self] of link-neighbors] of turtles with [ cluster-id = cid ]]"," count turtles with [ cluster-id = cid] with-max[[length [self] of link-neighbors] of turtles with [ cluster-id = cid ]])
    set line ( word line mean [nw:betweenness-centrality ] of turtles with [ cluster-id = cid ] "," min [nw:betweenness-centrality ] of turtles with [ cluster-id = cid ] "," max [nw:betweenness-centrality ] of turtles with [ cluster-id = cid ] )
    set line ( word line "," count turtles with [ cluster-id = cid] with-min [[nw:betweenness-centrality ] of turtles with [ cluster-id = cid ]]"," count turtles with [ cluster-id = cid] with-max [[nw:betweenness-centrality ] of turtles with [ cluster-id = cid ]] )
    set line ( word line "," nw:modularity (list (turtles with [ cluster-id = cid])) ","   mean [nw:page-rank ] of turtles with [ cluster-id = cid ])
    file-print line
  ]
  file-close
  ask links [ set hidden? false ]
  ;nw:save-matrix (word "./matrixfiles/matrix-" ticks ".txt")
  ask links [ set hidden? true ]
end

to-report rx-engaged-with-r
